<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Version advanced by 1" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def expected = ((props.getProperty('uver') as long) + 1).toString()
if (json.version != expected) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('version ' + json.version + ', expected ' + expected + ': lost update or double apply')
}</stringProp></JSR223Assertion><hashTree/>
