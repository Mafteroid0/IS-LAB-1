<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Exactly one matching object exists" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">def data = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
String run = props.getProperty('lab.run')
assert data.count { it.name.strip().equalsIgnoreCase('race-route-' + run) } == 1
assert data.count { it.name == 'race-import-' + run } == 1</stringProp></JSR223Assertion>
