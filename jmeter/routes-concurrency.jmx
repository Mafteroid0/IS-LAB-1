<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Write identical import file" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">def run = props.getProperty('lab.run')
def rows = [[name: 'race-import-' + run,
  coordinates: [x: 4242.5, y: props.getProperty('lab.y') as int],
  to: [x: 1, y: 1, z: 1, name: 'race-import-loc-' + run], distance: 10, rating: 4]]
def f = File.createTempFile('routelab-race-', '.json'); f.deleteOnExit()
f.write(groovy.json.JsonOutput.toJson(rows), 'UTF-8')
vars.put('IMPORT_FILE', f.absolutePath)</stringProp></JSR223PreProcessor>
