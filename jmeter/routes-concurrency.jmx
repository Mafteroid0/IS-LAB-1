<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Write import file" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def run = vars.get('RUN')
def t = ctx.getThreadNum()
def rows = (1..3).collect { i -&gt; [
  name: 'imp-' + run + '-' + t + '-' + i,
  coordinates: [x: 100000 + t * 10 + i, y: (run as int) % 100000],
  from: [x: 0, y: 0, z: 0, name: 'imp-from-' + run + '-' + t + '-' + i],
  to: [x: 1, y: 1, z: 1, name: 'imp-to-' + run + '-' + t + '-' + i],
  distance: 10 + i, rating: i ] }
def f = File.createTempFile('routelab-import-', '.json'); f.deleteOnExit()
f.write(groovy.json.JsonOutput.toJson(rows), 'UTF-8')
vars.put('IMPORT_FILE', f.absolutePath)</stringProp></JSR223PreProcessor><hashTree/>
