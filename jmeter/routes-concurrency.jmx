<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Initialize unique run data" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def run = props.getProperty('run', UUID.randomUUID().toString().replace('-', '').take(16))
int users = props.getProperty('users', '10') as int
assert run ==~ /[A-Za-z0-9]{1,20}/ : 'run must contain 1-20 ASCII letters or digits'
assert users &gt;= 2 &amp;&amp; users &lt;= 100 : 'users must be between 2 and 100'
props.setProperty('lab.run', run)
long hash = UUID.nameUUIDFromBytes(run.getBytes('UTF-8')).mostSignificantBits
props.setProperty('lab.x', (1000000 + ((hash &gt;&gt;&gt; 24) &amp; 0x7FFFFF)).toString())
props.setProperty('lab.y', (1000000 + (hash &amp; 0x7FFFFF)).toString())
['coordinates', 'location', 'route', 'import', 'update', 'delete'].each { props.remove('ok.' + it) }
(0..1).each { props.remove('mixed.status.' + it) }</stringProp></JSR223Sampler>
