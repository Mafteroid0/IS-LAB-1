<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Persisted outcome matches winning request" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">boolean updated = props.getProperty('mixed.status.0') == '200'
String expectedCode = updated ? '200' : '404'
prev.setSuccessful(prev.responseCode == expectedCode)
assert prev.responseCode == expectedCode
if (updated) {
  def data = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
  assert data.name == 'mixed-update-' + props.getProperty('lab.run')
  assert data.version.toLong() == (props.getProperty('mver').toLong() + 1)
}</stringProp></JSR223Assertion>
