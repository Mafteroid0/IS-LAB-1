<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Count winners" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def expected = ['ok.coordinates': 1, 'ok.location': 1, 'ok.route': 1, 'ok.import': 1, 'ok.update': 1, 'ok.delete': 1]
expected.each { key, value -&gt;
  def actual = props.getProperty(key) ?: '0'
  if (actual != value.toString()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(key + ': expected ' + value + ' success, got ' + actual)
  }
}</stringProp></JSR223Assertion><hashTree/>
