<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Only own operations with correct status and count" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def rows = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
String username = 'crud' + props.getProperty('lab.run') + '_' + (ctx.threadNum + 1)
assert rows.size() == 2 &amp;&amp; rows.every { it.username == username }
assert rows.find { it.id == vars.get('successImport') &amp;&amp; it.status == 'SUCCESS' &amp;&amp; it.added == 3 }
assert rows.find { it.id &amp;&amp; it.status == 'FAILED' &amp;&amp; it.added == null }</stringProp></JSR223Assertion>
<hashTree/>
</hashTree>
