<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Write import file" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">def run = props.getProperty('lab.run')
def thread = ctx.threadNum
def row = [name: "rollback-$run-$thread",
  coordinates: [x: -400000 - thread, y: props.getProperty('lab.y') as int],
  to: [x: 1, y: 1, z: 1, name: "rollback-to-$run-$thread"], distance: 5, rating: 1]
def rows = [row, row + [name: row.name.toUpperCase(Locale.ROOT) + '  ']]
def f = File.createTempFile('routelab-rollback-', '.json'); f.deleteOnExit()
f.write(groovy.json.JsonOutput.toJson(rows), 'UTF-8')
vars.put('IMPORT_FILE', f.absolutePath)</stringProp></JSR223PreProcessor>
