<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Three imported routes" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def row = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
